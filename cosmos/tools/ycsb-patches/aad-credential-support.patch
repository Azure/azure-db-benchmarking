+package site.ycsb.db;
+
+import com.azure.core.credential.AccessToken;
+import com.azure.core.credential.TokenCredential;
+import com.azure.core.credential.TokenRequestContext;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import reactor.core.publisher.Mono;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.time.Duration;
+import java.time.Instant;
+import java.time.OffsetDateTime;
+import java.time.ZoneOffset;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * A {@link TokenCredential} that serves pre-generated AAD (Entra) tokens read from a text file with one token per
+ * line. It is meant for load tests where the token itself (for example its size) is the variable under test.
+ *
+ * <p>Modes:
+ * <ul>
+ * <li>{@code single}: every call returns the first token in the file.</li>
+ * <li>{@code unique}: every call returns the next token in the file (round robin).</li>
+ * </ul>
+ *
+ * <p>Note that the Cosmos DB SDK caches the token it gets from the credential and only calls
+ * {@link #getToken(TokenRequestContext)} again when the cached token is close to expiry (and at most once every
+ * 30 seconds per client), so {@code unique} mode changes the token presented by a client on token refresh, not on every
+ * request.
+ */
+public class FileTokenCredential implements TokenCredential {
+
+  /** How tokens from the file are handed out. */
+  public enum Mode {
+    SINGLE, UNIQUE;
+
+    static Mode parse(String value) {
+      if (value == null || value.trim().isEmpty()) {
+        return SINGLE;
+      }
+      switch (value.trim().toLowerCase()) {
+      case "single":
+        return SINGLE;
+      case "unique":
+        return UNIQUE;
+      default:
+        throw new IllegalArgumentException(
+            "Invalid azurecosmos.aadTokenMode '" + value + "'. Use 'single' or 'unique'.");
+      }
+    }
+  }
+
+  private static final ObjectMapper MAPPER = new ObjectMapper();
+  // The Cosmos SDK refreshes a cached token once it is within 5 minutes of its expiry. Reporting an expiry that is
+  // just inside that window makes the SDK ask for a new token (at most every 30 seconds) in unique mode.
+  private static final Duration UNIQUE_MODE_REPORTED_LIFETIME = Duration.ofMinutes(5);
+  private static final Duration FALLBACK_LIFETIME = Duration.ofHours(1);
+
+  private final List<String> tokens;
+  private final Mode mode;
+  private final AtomicLong index = new AtomicLong();
+
+  public FileTokenCredential(String tokenFilePath, String mode) throws IOException {
+    List<String> loaded = new ArrayList<>();
+    for (String line : Files.readAllLines(Paths.get(tokenFilePath), StandardCharsets.UTF_8)) {
+      String token = line.trim();
+      if (!token.isEmpty()) {
+        loaded.add(token);
+      }
+    }
+    if (loaded.isEmpty()) {
+      throw new IllegalArgumentException("No tokens found in azurecosmos.aadTokenFile.");
+    }
+    this.tokens = Collections.unmodifiableList(loaded);
+    this.mode = Mode.parse(mode);
+  }
+
+  /** Number of tokens loaded from the file. */
+  public int getTokenCount() {
+    return tokens.size();
+  }
+
+  public Mode getMode() {
+    return mode;
+  }
+
+  @Override
+  public Mono<AccessToken> getToken(TokenRequestContext request) {
+    return Mono.fromSupplier(this::nextAccessToken);
+  }
+
+  private AccessToken nextAccessToken() {
+    String token;
+    if (mode == Mode.UNIQUE) {
+      token = tokens.get((int) (index.getAndIncrement() % tokens.size()));
+    } else {
+      token = tokens.get(0);
+    }
+
+    OffsetDateTime expiresAt;
+    if (mode == Mode.UNIQUE) {
+      expiresAt = OffsetDateTime.now().plus(UNIQUE_MODE_REPORTED_LIFETIME);
+    } else {
+      expiresAt = parseExpiry(token);
+    }
+    return new AccessToken(token, expiresAt);
+  }
+
+  static OffsetDateTime parseExpiry(String jwt) {
+    OffsetDateTime fallback = OffsetDateTime.now().plus(FALLBACK_LIFETIME);
+    try {
+      String[] parts = jwt.split("\\.");
+      if (parts.length < 2) {
+        return fallback;
+      }
+      byte[] payload = Base64.getUrlDecoder().decode(parts[1]);
+      JsonNode exp = MAPPER.readTree(payload).get("exp");
+      if (exp == null || !exp.canConvertToLong()) {
+        return fallback;
+      }
+      return OffsetDateTime.ofInstant(Instant.ofEpochSecond(exp.asLong()), ZoneOffset.UTC);
+    } catch (Exception e) {
+      return fallback;
+    }
+  }
+}
