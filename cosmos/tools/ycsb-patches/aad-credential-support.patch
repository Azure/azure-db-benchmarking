+  private boolean shouldExecuteMetadataOperation() {
+    if (AzureCosmosClient.metadataOperation == MetadataOperation.NONE) {
+      return false;
+    }
+    int percentage = AzureCosmosClient.metadataPercentage;
+    return percentage >= 100 || ThreadLocalRandom.current().nextInt(100) < percentage;
+  }
+
+  /**
+   * Lists all databases or all containers of the configured database and iterates every page.
+   * Metadata requests are small but carry the full Authorization header like any other request.
+   */
+  private Status executeMetadataOperation() {
+    MetadataOperation operation = AzureCosmosClient.metadataOperation;
+    if (operation == MetadataOperation.MIXED) {
+      operation = ThreadLocalRandom.current().nextBoolean()
+          ? MetadataOperation.LIST_DATABASES : MetadataOperation.LIST_CONTAINERS;
+    }
+
+    try {
+      long st = System.nanoTime();
+      if (operation == MetadataOperation.LIST_DATABASES) {
+        for (FeedResponse<CosmosDatabaseProperties> page : AzureCosmosClient.client.readAllDatabases()
+            .iterableByPage()) {
+          this.logSlowMetadataDiagnostics(page.getCosmosDiagnostics());
+        }
+      } else {
+        for (FeedResponse<CosmosContainerProperties> page : AzureCosmosClient.database.readAllContainers()
+            .iterableByPage()) {
+          this.logSlowMetadataDiagnostics(page.getCosmosDiagnostics());
+        }
+      }
+
+      if (metadataSuccessLatencyTimer != null) {
+        long en = System.nanoTime();
+        long latency = (en - st) / 1000;
+        metadataSuccessLatencyTimer.record(latency, TimeUnit.MICROSECONDS);
+        metadataSuccessCounter.increment();
+      }
+      return Status.OK;
+    } catch (CosmosException e) {
+      int statusCode = e.getStatusCode();
+      if (!AzureCosmosClient.includeExceptionStackInLog) {
+        e = null;
+      }
+      LOGGER.error(METADATA_EXCEPTION, "Failed to execute metadata operation {} in database {} statusCode {}",
+          operation, AzureCosmosClient.databaseName, statusCode, e);
+      if (metadataFailureCounter != null) {
+        metadataFailureCounter.increment();
+      }
+      return Status.ERROR;
+    }
+  }
+
+  private void logSlowMetadataDiagnostics(CosmosDiagnostics diagnostics) {
+    if (diagnosticsLatencyThresholdInMS > 0 && diagnostics != null &&
+        diagnostics.getDuration().compareTo(Duration.ofMillis(diagnosticsLatencyThresholdInMS)) > 0) {
+      LOGGER.warn(METADATA_DIAGNOSTIC, diagnostics.toString());
+    }
+  }
